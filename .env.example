# ---------------------------------------------------------------------------
# Mannazia deployment settings. Copy this file to `.env` and edit as needed.
# Docker Compose reads `.env` automatically for variable substitution.
# ---------------------------------------------------------------------------

# Host port for the web interface (inside the container it is always 8080).
MANNAZIA_PORT=8080

# UID/GID of the NAS user who owns ./config, ./data and ./books.
# Use `id -u` and `id -g` on the NAS host. Both files and the container run
# with these numeric IDs; no root container is required.
PUID=1000
PGID=1000
TZ=UTC

# Application log level and environment label.
MANNAZIA_LOG_LEVEL=INFO
MANNAZIA_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# SSRF / network policy
# ---------------------------------------------------------------------------
# Keep false unless you intentionally run Mannazia on a developer workstation.
# true allows requests to ANY private/loopback destination.
MANNAZIA_ALLOW_PRIVATE_NETWORKS=false

# Exact hostnames that may resolve to private addresses (comma separated).
# Use this for a known IIIF server on your LAN instead of opening everything.
# Example: MANNAZIA_ALLOWED_PRIVATE_HOSTS=iiif.lan,library.local
MANNAZIA_ALLOWED_PRIVATE_HOSTS=

# Request limits. Bytes unless noted.
MANNAZIA_MAX_MANIFEST_BYTES=8388608
MANNAZIA_MAX_IMAGE_BYTES=209715200
MANNAZIA_MAX_REDIRECTS=5
MANNAZIA_HTTP_TIMEOUT=30
MANNAZIA_HTTP_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------------------
# Downloads
# ---------------------------------------------------------------------------
# Global concurrent page fetches (1-16).
MANNAZIA_DOWNLOAD_CONCURRENCY=3
# Optional global ceiling for the resized download tiers (Reading / Standard /
# Appreciation), in pixels. 0 = no additional ceiling (default). Clamped to
# 200..12000. Research always requests the maximum available source size.
MANNAZIA_DOWNLOAD_MAX_WIDTH=0
# Width requested for the cached cover image. This image is downloaded once at
# import so the bookshelf cover stays crisp; it is not counted as a page.
MANNAZIA_COVER_MAX_WIDTH=1200
# Cache page thumbnails at import for the reader's thumbnail strip.
MANNAZIA_PAGE_THUMBNAILS_ENABLED=true
MANNAZIA_THUMBNAIL_CONCURRENCY=4
MANNAZIA_THUMBNAIL_MAX_BYTES=33554432
# jpg, png or webp. Used only when the advertised IIIF service supports it.
MANNAZIA_DOWNLOAD_IMAGE_FORMAT=jpg
# Transient retries per page (network errors, 5xx, 429).
MANNAZIA_DOWNLOAD_RETRIES=3
# If true, jobs interrupted by a container restart are automatically resumed.
# The safe default is to reconcile them as paused and let you resume manually.
MANNAZIA_AUTO_RESUME_DOWNLOADS=false

# Preview cache lifetime in seconds.
MANNAZIA_PREVIEW_TTL_SECONDS=900

# Comma-separated reverse-proxy addresses allowed to set X-Forwarded-* headers.
# Only change when you put Mannazia behind a reverse proxy. "*" trusts every
# client and is not appropriate for direct exposure.
FORWARDED_ALLOW_IPS=127.0.0.1
